{
  "name": "birb",
  "productName": "Birb",
  "version": "1.0.0",
  "description": "A small, quiet text editor with tabs and a CSV table view that keeps your formatting.",
  "main": "main.js",
  "homepage": "https://JJJoaten.github.io/birb",
  "license": "MIT",
  "author": {
    "name": "J",
    "email": "JJJoaten@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJJoaten/birb.git"
  },
  "bin": {
    "birb": "bin/birb.js"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.birb.editor",
    "productName": "Birb",
    "copyright": "Copyright (c) 2026 J",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "log"
        ],
        "name": "Text document",
        "role": "Editor"
      },
      {
        "ext": [
          "csv",
          "tsv"
        ],
        "name": "CSV document",
        "role": "Editor"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": [
          "json",
          "xml",
          "yml",
          "yaml",
          "ini",
          "conf",
          "cfg"
        ],
        "name": "Config file",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon-mac.png",
      "artifactName": "Birb-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Birb-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Birb-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility;TextEditor",
      "executableName": "birb",
      "maintainer": "J <JJJoaten@users.noreply.github.com>",
      "synopsis": "A small, quiet text editor",
      "artifactName": "Birb-${version}-linux-${arch}.${ext}",
      "mimeTypes": [
        "text/plain",
        "text/csv",
        "text/tab-separated-values",
        "text/markdown"
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": ">=33.0.0",
    "electron-builder": ">=25.0.0"
  }
}
